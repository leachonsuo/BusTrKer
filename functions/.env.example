# Optional internal GBIS reservation ceilings. Portal-approved developer quota: 1,000/day per service.
# These are conservative local application limits, not the public-data portal's reset policy.
# For the emulator, copy to .env.local only if you need different values. Never put the service key here.
GBIS_BUDGET_ROUTES=800
GBIS_BUDGET_STATIONS=800
GBIS_BUDGET_LOCATIONS=800
GBIS_BUDGET_ARRIVALS=800
# File mode is the default for Functions Emulator. Production requires explicit
# GBIS_BUDGET_STORE=firestore after an existing Firestore database, IAM and rules are reviewed.
# Emulator Firestore mode additionally requires a demo-* project and local Firestore Emulator.
# GBIS_BUDGET_STORE=firestore
